# Vikāsa Backend Configuration
# Copy to .env and customize for your environment

# Flask API
API_HOST=0.0.0.0
API_PORT=5000
FLASK_ENV=development

# CORS - set to your frontend origin (e.g., http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Storage Backend: "memory" (default) or "firebase"
STORAGE_BACKEND=memory

# Firebase Configuration (required when STORAGE_BACKEND=firebase)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CREDENTIALS_PATH=/path/to/service-account.json
# FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com/

# Logging
LOG_LEVEL=INFO

# Optional: Custom reading ID validation (regex)
# READING_ID_PATTERN=^[A-Z0-9-]{1,64}$
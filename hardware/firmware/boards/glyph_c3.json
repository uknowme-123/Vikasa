{
  "name": "PCB CUPID GLYPH C3 (ESP32-C3-MINI-1-N4)",
  "vendor": "PCB CUPID",
  "url": "https://learn.pcbcupid.com/documentation/modules/glyph/glyph-esp32c3/overview-glyph-c3",
  "frameworks": [
    "arduino"
  ],
  "connectivity": [
    "wifi",
    "bluetooth"
  ],
  "build": {
    "arduino": {
      "ldscript": "esp32c3_out.ld"
    },
    "core": "esp32",
    "f_cpu": "160000000L",
    "f_flash": "80000000L",
    "flash_mode": "dio",
    "extra_flags": "-DARDUINO_ESP32C3_DEV -DARDUINO_USB_MODE=1 -DARDUINO_USB_CDC_ON_BOOT=1",
    "mcu": "esp32c3",
    "variant": "esp32c3"
  },
  "debug": {
    "openocd_target": "esp32c3.cfg"
  },
  "upload": {
    "flash_size": "4MB",
    "maximum_ram_size": 327680,
    "maximum_size": 4194304,
    "require_upload_port": true,
    "speed": 460800
  }
}
